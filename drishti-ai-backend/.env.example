# Python 3.11. Android camera -> laptop CPU inference -> client-native TTS.
API_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MODEL_PATH=weights/yolov8n.pt
ALLOW_MODEL_DOWNLOAD=false
INFERENCE_DEVICE=cpu
CONFIDENCE_THRESHOLD=0.35
INFERENCE_SIZE=640
PROCESSING_FPS=2
MAX_UPLOAD_BYTES=4194304
MAX_IMAGE_PIXELS=12000000
CAMERA_TIMEOUT=8
ANNOUNCEMENT_COOLDOWN=6
REPEAT_AFTER=20
DATABASE_PATH=data/drishti.sqlite3
# Windows only, if Tesseract is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Speak distinct detected object/position groups in fair short batches.
VOICE_BATCH_SIZE=4
HAPTIC_COOLDOWN=2
